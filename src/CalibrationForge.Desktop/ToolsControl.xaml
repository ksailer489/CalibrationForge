<UserControl x:Class="CalibrationForge.Desktop.ToolsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Read and verify" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="Offline files and ordered trace replay. No adapter, upload, code clearing, repair or flashing." Foreground="{DynamicResource WorkbenchMuted}" Margin="0,6,0,16"/>
        </StackPanel>
        <WrapPanel Grid.Row="1">
            <Button Content="Identity demo" Click="Demo_Click" IsEnabled="{Binding CanStart}" AutomationProperties.AutomationId="ToolsIdentityDemo"/>
            <Button Content="Replay identity…" Click="Replay_Click" IsEnabled="{Binding CanStart}" AutomationProperties.AutomationId="ToolsIdentityReplay"/>
            <Button Content="Verify file → ZIP…" Click="Verify_Click" IsEnabled="{Binding CanStart}" AutomationProperties.AutomationId="ToolsVerifyFile"/>
            <Button Content="Analyze checksums…" Click="Checksum_Click" IsEnabled="{Binding CanStart}" AutomationProperties.AutomationId="ToolsChecksum"/>
            <Button Content="Export support log…" Click="Support_Click" IsEnabled="{Binding CanStart}" AutomationProperties.AutomationId="ToolsSupportLog"/>
        </WrapPanel>
        <Border Grid.Row="2" Background="{DynamicResource WorkbenchSurface}" Padding="14" Margin="0,8,0,12" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="{Binding Provenance}" Foreground="#FFD977" FontWeight="SemiBold" AutomationProperties.AutomationId="ToolsProvenance"/>
                <TextBlock Text="Checksum analysis requires the exact supported public reference. Observed calibration sums do not cover the full image; no checksum repair or flash validation." Margin="0,8,0,0" Foreground="{DynamicResource WorkbenchMuted}"/>
            </StackPanel>
        </Border>
        <TextBox Grid.Row="3" Text="{Binding Result, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas"
                 VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="ToolsResult"/>
        <Border Grid.Row="4" Background="{DynamicResource WorkbenchSurface}" Padding="14" Margin="0,12,0,0" CornerRadius="6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Cancel" Click="Cancel_Click" IsEnabled="{Binding IsBusy}" AutomationProperties.AutomationId="ToolsCancel" Margin="12,0,0,0"/>
                <StackPanel>
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="5" Margin="0,0,0,10" AutomationProperties.AutomationId="ToolsProgress"/>
                    <TextBlock Text="{Binding Status}" AutomationProperties.AutomationId="ToolsStatus" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
