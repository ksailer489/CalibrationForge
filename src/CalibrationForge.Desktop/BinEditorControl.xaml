<UserControl x:Class="CalibrationForge.Desktop.BinEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="#E5EDF8" Language="en-US"
             PreviewKeyDown="Editor_PreviewKeyDown">
    <UserControl.Resources>
        <DataTemplate x:Key="BinCellTemplate">
            <Border Padding="6,4" ToolTip="{Binding Comparison}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                <Setter Property="Background" Value="#604917"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Current, StringFormat={}{0:0.#########}}" TextWrapping="NoWrap"
                           Foreground="#F1F5FF" AutomationProperties.Name="{Binding Coordinate}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="12" Background="#101827">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" MinHeight="220" MaxHeight="340"/>
            <RowDefinition Height="3*" MinHeight="100"/>
            <RowDefinition Height="2*" MinHeight="120" MaxHeight="240"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.AutomationId="BinHeaderScroll">
        <StackPanel>
            <TextBlock Text="BIN inspection / experimental offline editor" FontSize="20" FontWeight="SemiBold"/>
            <Border Background="#453617" Padding="8" Margin="0,6">
                <StackPanel>
                    <TextBlock Text="Checksums unchanged; NOT flash-ready; no physical ECM access or flashing." Foreground="#FFD977" FontWeight="Bold"/>
                    <TextBlock Text="Export to a NEW file only; loaded original preserved. Checksums may be invalid after edits." Foreground="#FFD977"/>
                </StackPanel>
            </Border>
            <DockPanel>
                <Button Content="Load real BIN…" Click="Load_Click" IsEnabled="{Binding CanLoad}"
                        AutomationProperties.AutomationId="BinLoadButton" DockPanel.Dock="Left"/>
                <TextBlock Text="{Binding Source}" Foreground="#A8B9D0" VerticalAlignment="Center"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Source}"/>
            </DockPanel>
            <TextBlock Text="{Binding ProfileStatus}" TextWrapping="Wrap" FontSize="12"
                       AutomationProperties.AutomationId="BinProfileStatusText"/>
            <TextBlock Text="Vehicle provenance unknown; experimental/community mapping, not GM-verified. NOT a verified 2017 Camaro calibration."
                       Foreground="#FFD977" TextWrapping="Wrap" FontSize="12"
                       AutomationProperties.AutomationId="BinProvenanceText"/>
            <Expander Header="Sample metadata, experimental mapping and limitations" Foreground="#E5EDF8">
                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBox Text="{Binding Metadata, Mode=OneWay}" IsReadOnly="True" Background="Transparent" Foreground="#E5EDF8"
                                 BorderThickness="0" TextWrapping="Wrap" AutomationProperties.AutomationId="BinMetadataText"/>
                        <TextBlock Text="{Binding TableDescription}" Foreground="#A8B9D0"/>
                        <TextBlock Text="{Binding Encoding}" Foreground="#FFD977"/>
                        <TextBlock Text="{Binding Attribution}" Foreground="#F5DBA4" FontSize="11"/>
                    </StackPanel>
                </ScrollViewer>
            </Expander>
            <ComboBox ItemsSource="{Binding AvailableTables}" SelectedItem="{Binding SelectedTable}"
                      DisplayMemberPath="Name" IsEnabled="{Binding CanSelectTable}" Margin="0,6,0,2"
                      AutomationProperties.AutomationId="BinTableSelector" AutomationProperties.Name="Calibration table"/>
            <CheckBox Content="Enable additional experimental table editing (off by default)"
                      IsChecked="{Binding AdditionalTableEditsEnabled}" IsEnabled="{Binding CanEnableAdditionalTableEdits}"
                      AutomationProperties.AutomationId="BinAdditionalTableEdits"
                      ToolTip="Fuel reference values are not power-enrichment targets. Disabling preserves existing edits and undo history."/>
            <TextBlock Text="{Binding TableName}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,2"
                       AutomationProperties.AutomationId="BinTableNameText"/>
            <TextBlock Text="{Binding TableMeaning}" TextWrapping="Wrap" AutomationProperties.AutomationId="BinTableMeaningText"/>
            <WrapPanel Margin="0,4">
                <TextBlock Text="{Binding RowAxisCaption, StringFormat=Rows: {0}}" Margin="0,0,20,0"
                           AutomationProperties.AutomationId="BinRowAxisText"/>
                <TextBlock Text="{Binding ColumnAxisCaption, StringFormat=Columns: {0}}" Margin="0,0,20,0"
                           AutomationProperties.AutomationId="BinColumnAxisText"/>
                <TextBlock Text="{Binding ValueCaption}" FontWeight="Bold" AutomationProperties.AutomationId="BinValueCaptionText"/>
            </WrapPanel>
            <TextBlock Text="{Binding AxisQualification}" Foreground="#FFD977" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="BinAxisQualificationText"/>
            <TextBlock Text="Bold gold cells differ from original. Technical indices and byte offsets appear in cell details."
                       FontSize="12" Foreground="#A8B9D0" Margin="0,4"/>
        </StackPanel>
        </ScrollViewer>
        <DataGrid x:Name="MatrixGrid" Grid.Row="1" ItemsSource="{Binding Rows}" IsReadOnly="True"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="False" CanUserSortColumns="False" SelectionMode="Single" SelectionUnit="Cell"
                  SelectedCellsChanged="Matrix_SelectedCellsChanged" HeadersVisibility="All" RowHeaderWidth="80"
                  AutomationProperties.AutomationId="BinCellsGrid" EnableRowVirtualization="True"
                  EnableColumnVirtualization="True" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto" MinHeight="100">
            <DataGrid.RowHeaderStyle>
                <Style TargetType="DataGridRowHeader">
                    <Setter Property="Content" Value="{Binding Header}"/>
                    <Setter Property="Background" Value="#29415F"/>
                    <Setter Property="Foreground" Value="#E5EDF8"/>
                </Style>
            </DataGrid.RowHeaderStyle>
        </DataGrid>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.AutomationId="BinFooterScroll">
        <StackPanel Margin="0,6,0,0">
            <TextBlock Text="{Binding CurrentValue}" AutomationProperties.AutomationId="BinCurrentValueText" FontSize="12" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,4,0,0">
                <TextBox x:Name="ValueInput" Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}"
                         KeyDown="ValueInput_KeyDown"
                         ToolTip="F2 from the table focuses this input. Enter applies; Escape restores the current value."
                         Width="140" Margin="0,0,8,4" Padding="5" AutomationProperties.AutomationId="BinValueInput"/>
                <Button Content="Apply cell" Click="Apply_Click" IsEnabled="{Binding CanApply}" AutomationProperties.AutomationId="BinApplyButton"/>
                <Button Content="Revert cell" Click="RevertCell_Click" IsEnabled="{Binding CanRevertCell}" AutomationProperties.AutomationId="BinRevertCellButton"/>
                <Button Content="Revert all" Click="RevertAll_Click" IsEnabled="{Binding CanRevert}" AutomationProperties.AutomationId="BinRevertAllButton"/>
                <Button Content="Undo" Click="Undo_Click" IsEnabled="{Binding CanUndo}" AutomationProperties.AutomationId="BinUndo" ToolTip="Undo BIN edit (Ctrl+Z outside text input)"/>
                <Button Content="Redo" Click="Redo_Click" IsEnabled="{Binding CanRedo}" AutomationProperties.AutomationId="BinRedo" ToolTip="Redo BIN edit (Ctrl+Y outside text input)"/>
                <Button Content="Review / export new BIN…" Click="Export_Click" IsEnabled="{Binding CanExport}" AutomationProperties.AutomationId="BinExportButton"/>
                <Button Content="Cancel operation" Click="Cancel_Click" IsEnabled="{Binding IsBusy}" AutomationProperties.AutomationId="BinCancel"/>
            </WrapPanel>
            <TextBlock Text="{Binding ValidationMessage}" Foreground="#FFD977" FontSize="12" AutomationProperties.AutomationId="BinValidationText"/>
            <Expander Header="{Binding ChangeSummary}" Foreground="#E5EDF8" AutomationProperties.AutomationId="BinChangesExpander">
                <ListBox ItemsSource="{Binding ChangedCells}" MaxHeight="110" Background="#1B293D" Foreground="#E5EDF8"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.AutomationId="BinChangesList">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Comparison}" TextWrapping="NoWrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Expander>
            <TextBlock Text="{Binding DirtyState}" Foreground="#FFD977" AutomationProperties.AutomationId="BinDirtyStateText" FontSize="12"/>
            <TextBlock Text="{Binding Status}" AutomationProperties.AutomationId="BinStatusText" FontSize="12"
                       AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
