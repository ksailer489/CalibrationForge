<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WorkbenchBackground" Color="#101827"/>
    <SolidColorBrush x:Key="WorkbenchSurface" Color="#1B293D"/>
    <SolidColorBrush x:Key="WorkbenchForeground" Color="#E5EDF8"/>
    <SolidColorBrush x:Key="WorkbenchMuted" Color="#A8B9D0"/>
    <SolidColorBrush x:Key="WorkbenchAccent" Color="#8EBFD4"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#101827"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E5EDF8"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1B293D"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E5EDF8"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#315A78"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
    <Style x:Key="WorkbenchFocus">
        <Setter Property="Control.Template">
            <Setter.Value><ControlTemplate><Rectangle Margin="2" Stroke="#8EBFD4" StrokeThickness="2" StrokeDashArray="2 1"/></ControlTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Control" x:Key="WorkbenchControl">
        <Setter Property="Foreground" Value="{DynamicResource WorkbenchForeground}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource WorkbenchFocus}"/>
        <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource WorkbenchControl}">
        <Setter Property="Background" Value="#29415F"/>
        <Setter Property="BorderBrush" Value="#5D809E"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="Margin" Value="0,0,10,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#365978"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#197F83"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#8EBFD4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource WorkbenchControl}">
        <Setter Property="Background" Value="{DynamicResource WorkbenchBackground}"/>
        <Setter Property="BorderBrush" Value="#5D809E"/>
        <Setter Property="CaretBrush" Value="White"/>
        <Setter Property="Padding" Value="8,6"/>
        <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#8EBFD4"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource WorkbenchControl}"/>
    <Style TargetType="Label" BasedOn="{StaticResource WorkbenchControl}"/>
    <Style TargetType="Expander" BasedOn="{StaticResource WorkbenchControl}"/>
    <Style TargetType="ComboBox" BasedOn="{StaticResource WorkbenchControl}">
        <Setter Property="Background" Value="{DynamicResource WorkbenchSurface}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#1B293D"/><Setter Property="Foreground" Value="#E5EDF8"/></Style></Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton"><Border Background="#1B293D" BorderBrush="#5D809E" BorderThickness="1" Padding="8,5"><TextBlock Text="▾" HorizontalAlignment="Right" Foreground="#E5EDF8"/></Border></ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="8,5,28,5" IsHitTestVisible="False"/>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                            <Border Background="#1B293D" BorderBrush="#5D809E" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="300"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TabControl" BasedOn="{StaticResource WorkbenchControl}">
        <Setter Property="Background" Value="{DynamicResource WorkbenchBackground}"/>
        <Setter Property="BorderBrush" Value="#344B66"/>
    </Style>
    <Style TargetType="TabItem" BasedOn="{StaticResource WorkbenchControl}">
        <Setter Property="Background" Value="#1B293D"/>
        <Setter Property="Padding" Value="18,12"/>
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="TabItem">
                <Border x:Name="TabSurface" Background="{TemplateBinding Background}" BorderBrush="#344B66" BorderThickness="0,0,1,2" Padding="{TemplateBinding Padding}">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#29415F"/><Setter TargetName="TabSurface" Property="BorderBrush" Value="#8EBFD4"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#365978"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="DataGrid" BasedOn="{StaticResource WorkbenchControl}">
        <Setter Property="Background" Value="#101827"/>
        <Setter Property="RowBackground" Value="#1B293D"/>
        <Setter Property="AlternatingRowBackground" Value="#22334A"/>
        <Setter Property="BorderBrush" Value="#344B66"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#344B66"/>
        <Setter Property="VerticalGridLinesBrush" Value="#344B66"/>
    </Style>
    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource WorkbenchControl}">
        <Setter Property="Background" Value="#29415F"/>
        <Setter Property="BorderBrush" Value="#344B66"/>
        <Setter Property="Padding" Value="8"/>
    </Style>
    <Style TargetType="DataGridRowHeader" BasedOn="{StaticResource WorkbenchControl}">
        <Setter Property="Background" Value="#29415F"/>
        <Setter Property="Padding" Value="6"/>
    </Style>
    <Style TargetType="DataGridCell" BasedOn="{StaticResource WorkbenchControl}">
        <Setter Property="Padding" Value="5"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#315A78"/><Setter Property="Foreground" Value="White"/></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#8EBFD4"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="#8EBFD4"/>
        <Setter Property="Background" Value="#101827"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="WorkbenchScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="Thumb">
                <Border x:Name="ThumbSurface" Background="#526C88" CornerRadius="4" Margin="2"/>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#8EBFD4"/></Trigger>
                    <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#8EBFD4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="WorkbenchScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource WorkbenchControl}">
        <Setter Property="Width" Value="14"/>
        <Setter Property="MinHeight" Value="14"/>
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Border Background="#101827">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource WorkbenchScrollPage}" Command="{x:Static ScrollBar.PageUpCommand}"/></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb Style="{StaticResource WorkbenchScrollThumb}" MinHeight="24"/></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource WorkbenchScrollPage}" Command="{x:Static ScrollBar.PageDownCommand}"/></Track.IncreaseRepeatButton>
                    </Track>
                </Border>
            </ControlTemplate></Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value><ControlTemplate TargetType="ScrollBar">
                        <Border Background="#101827">
                            <Track x:Name="PART_Track" Orientation="Horizontal">
                                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource WorkbenchScrollPage}" Command="{x:Static ScrollBar.PageLeftCommand}"/></Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb Style="{StaticResource WorkbenchScrollThumb}" MinWidth="24"/></Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource WorkbenchScrollPage}" Command="{x:Static ScrollBar.PageRightCommand}"/></Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate></Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
