<Window x:Class="CalibrationForge.Desktop.ExportReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review original vs edited BIN" Width="1000" Height="560" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="#101827" Foreground="#E5EDF8"
        Language="en-US" AutomationProperties.AutomationId="BinExportReviewWindow">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="Original vs edited — review before export" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="All modified tables, including tables not currently selected" TextWrapping="Wrap" Margin="0,4"/>
            <TextBlock Text="{Binding ChangeSummary}" Margin="0,8" AutomationProperties.AutomationId="BinExportReviewCount"/>
            <TextBlock Text="Checksums unchanged and may be invalid; NOT flash-ready; no physical ECM access or flashing."
                       TextWrapping="Wrap" Foreground="#FFD977" FontWeight="Bold"/>
            <TextBlock Text="NEW file only; loaded original preserved. Units are experimental, not GM-verified."
                       TextWrapping="Wrap" Foreground="#FFD977"/>
            <TextBlock Text="Community-derived axes and values; not OEM/hardware validated." TextWrapping="Wrap" Foreground="#FFD977"/>
            <TextBlock Text="Comparison is against the loaded original, not the last export. Zero listed changes means restoration to original bytes."
                       TextWrapping="Wrap" Foreground="#A8B9D0"/>
        </StackPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding ChangedCells}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserSortColumns="False"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                  AutomationProperties.AutomationId="BinExportReviewGrid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Table" Binding="{Binding TableName}" Width="240"/>
                <DataGridTextColumn x:Name="RowAxisColumn" Header="Row index" Binding="{Binding RowLabel}" Width="160"/>
                <DataGridTextColumn x:Name="ColumnAxisColumn" Header="Column index" Binding="{Binding ColumnLabel}" Width="165"/>
                <DataGridTextColumn Header="Original" Binding="{Binding Original, StringFormat={}{0:0.#########}}" Width="120"/>
                <DataGridTextColumn Header="Edited" Binding="{Binding Current, StringFormat={}{0:0.#########}}" Width="120"/>
                <DataGridTextColumn Header="Delta" Binding="{Binding Delta, StringFormat={}{0:+0.#########;-0.#########;0}}" Width="120"/>
                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="130"/>
                <DataGridTextColumn Header="Indices" Binding="{Binding Coordinate}" Width="80"/>
                <DataGridTextColumn Header="Offset" Binding="{Binding Offset}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="16,8" Margin="0,0,12,0"
                    AutomationProperties.AutomationId="BinExportReviewCancelButton"/>
            <Button Content="Export experimental BIN" Click="Accept_Click" Padding="16,8"
                    AutomationProperties.AutomationId="BinExportReviewAcceptButton"/>
        </StackPanel>
    </Grid>
</Window>
