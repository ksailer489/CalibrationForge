<Window x:Class="CalibrationForge.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CalibrationForge - Offline workspace" Width="1060" Height="900"
        MinWidth="800" MinHeight="650" Background="#101827" Foreground="#E5EDF8"
        FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <DockPanel Background="{DynamicResource WorkbenchBackground}">
    <Border DockPanel.Dock="Bottom" Background="#1B293D" Padding="16,8" BorderBrush="#344B66" BorderThickness="0,1,0,0">
        <TextBlock Text="OFFLINE ONLY  ·  No vehicle connection or flashing  ·  Experimental results; originals preserved"
                   Foreground="#A8B9D0" FontSize="12" AutomationProperties.AutomationId="OfflineStatus"/>
    </Border>
    <TabControl>
    <TabItem Header="BIN editor" AutomationProperties.AutomationId="BinEditorTab">
        <ContentControl x:Name="BinEditorHost"/>
    </TabItem>
    <TabItem Header="Tools / Read and verify" AutomationProperties.AutomationId="ToolsTab">
        <ContentControl x:Name="ToolsHost"/>
    </TabItem>
    <TabItem Header="Diagnostics (offline)" AutomationProperties.AutomationId="DiagnosticsTab">
        <Grid Margin="24" TextElement.Foreground="#E5EDF8">
            <Grid.Resources>
                <BooleanToVisibilityConverter x:Key="FeatureVisibility"/>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <CheckBox x:Name="DiagnosticsFeatureSwitch" Content="Enable experimental offline diagnostics"
                      IsChecked="False" Foreground="#E5EDF8"
                      IsEnabled="{Binding Content.DataContext.CanLoad, ElementName=DiagnosticsHost}"
                      AutomationProperties.AutomationId="DiagnosticsFeatureSwitch"/>
            <ContentControl x:Name="DiagnosticsHost" Grid.Row="1"
                            Visibility="{Binding IsChecked, ElementName=DiagnosticsFeatureSwitch, Converter={StaticResource FeatureVisibility}}"/>
        </Grid>
    </TabItem>
    <TabItem Header="Simulator (16-byte demo)" AutomationProperties.AutomationId="SimulatorTab">
    <Grid Margin="28" TextElement.Foreground="#E5EDF8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="CalibrationForge" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock Text="Synthetic calibration workspace" Foreground="#9BAEC7" Margin="0,3,0,18"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#1B293D" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="SIMULATION ONLY · 16-byte in-memory demo, not an ECM image" Foreground="#FFD977"
                           FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <WrapPanel Margin="0,0,0,8">
                    <Button Content="Read simulator" AutomationProperties.AutomationId="ReadSimulatorButton"
                            IsEnabled="{Binding CanStart}" Click="ReadSimulator_Click" Background="#197F83"/>
                    <Button Content="Load 16-byte demo…" AutomationProperties.AutomationId="LoadImageButton"
                            IsEnabled="{Binding CanStart}" Click="LoadImage_Click"/>
                    <Button Content="Save 16-byte demo…" AutomationProperties.AutomationId="SaveImageButton"
                            IsEnabled="{Binding CanSaveOrWrite}" Click="SaveImage_Click"/>
                </WrapPanel>
                <Border Background="#1B293D" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="CURRENT IMAGE" Foreground="#8EBFD4" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ImageIdentity}" FontSize="18" Margin="0,8,0,4"/>
                        <TextBlock Text="{Binding Source}" Foreground="#A8B9D0"/>
                        <TextBlock Text="SHA256 · current valid image" Foreground="#8EBFD4" Margin="0,14,0,4"/>
                        <TextBox Text="{Binding ImageHash, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                 Background="Transparent" Foreground="#CFDEED" FontFamily="Consolas"
                                 TextWrapping="Wrap" AutomationProperties.AutomationId="ImageHashText"/>
                    </StackPanel>
                </Border>
                <Border Background="#1B293D" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="SYNTHETIC PARAMETER" Foreground="#8EBFD4" FontWeight="SemiBold"/>
                        <TextBlock Text="DemoLevel is an unsigned-byte demo value, not a torque, spark, or vehicle setting."
                                   Foreground="#A8B9D0" Margin="0,8,0,14"/>
                        <WrapPanel VerticalAlignment="Center">
                            <Label Content="{Binding ParameterLabel}" Target="{Binding ElementName=CalibrationValue}"
                                   Foreground="#E5EDF8" VerticalAlignment="Center" Padding="0,0,18,0"/>
                            <TextBox x:Name="CalibrationValue" AutomationProperties.AutomationId="CalibrationValueInput"
                                     AutomationProperties.Name="Synthetic DemoLevel"
                                     Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanEdit}" Width="120" FontSize="22" Padding="10,6"
                                     Background="#101827" Foreground="White" BorderBrush="#5D809E" Margin="0,0,18,8"/>
                            <Button Content="Write simulator + verify" AutomationProperties.AutomationId="WriteSimulatorButton"
                                    IsEnabled="{Binding CanSaveOrWrite}" Click="WriteSimulator_Click" Background="#197F83"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding ValidationMessage}" Foreground="#FFB6A5" Margin="0,4,0,8"/>
                        <TextBlock Text="{Binding DirtyState}" AutomationProperties.AutomationId="DirtyStateText"
                                   FontWeight="SemiBold" Foreground="#FFD977"/>
                        <TextBlock Text="{Binding Changes}" Foreground="#A8B9D0" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="Read / load → edit DemoLevel → save locally or write + verify. Writing compares an independent simulator readback byte-for-byte. Simulator contents reset when the application restarts."
                           Foreground="#9BAEC7" Margin="2,0,2,16"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="3" Background="#23334A" CornerRadius="8" Padding="16" Margin="0,12,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Cancel" Click="Cancel_Click" IsEnabled="{Binding CanCancel}"
                        AutomationProperties.AutomationId="CancelOperationButton" Margin="14,0,0,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="STATUS" Foreground="#8EBFD4" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding Status}" AutomationProperties.AutomationId="StatusText"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
    </TabItem>
    </TabControl>
    </DockPanel>
</Window>
